# Git cannot ignore by size, so data is ignored by format, wherever it is.
# Every script writes under out/, so in practice these rules act there. What
# stays tracked is source, documentation and the human-readable results: .txt
# reports, .tex tables and .md notes. A data file that should be kept anyway is
# either listed as an exception at the bottom or added with git add -f.
*.csv
*.gz
*.zip
*.npz
*.f32
*.json
*.Rdata
*.pdf
*.log

# Generated data with no single format: the simulated dataset, the per-firm
# runs, the throughput dataset and the older .Rdata-derived copy, 50 GB in all.
out/dataset/*

# Caches that also hold small text files beside the data, such as the fit
# cache's lineage.txt, so the format rules above do not cover them.
out/abm_system_fit_qvarma/
out/abm_system_fit_lp/
out/abm_system_fit_lp_r_levels/
out/throughput_fit_i*/
out/sweep_grid_response_cache/
out/old/naive_mae_loss/compressed_response_cache/
out/old/lp_r_levels_reproduction/before/

# Text manifests of those caches, 50 to 158 MB each. The small manifests are
# kept.
out/abm_system_fit_qvarma_manifest.txt
out/abm_system_fit_lp_manifest.txt
out/abm_system_fit_lp_r_levels_manifest.txt
out/montecarlo/lp_r_levels/abm_system_fit_lp_manifest.txt
out/throughput_fit_i*_manifest.txt
out/throughput_dataset_manifest.txt

# Build products. bin/ is rebuilt by make; the vendored simulator's binary
# comes from make model and its runs write an output/ beside it.
bin/
*.o
*.so
*.a
model/dsk_sfc/dsk_SFC
model/dsk_sfc/output/
__pycache__/

# Editor, system and session leftovers.
core
vgcore.*
nohup.out
.claude/
.DS_Store
_temp/

# R notebooks, except the brief the simulation workflow was derived from.
*.Rmd
!docs/Model_Simulation.Rmd

# Inputs nothing here regenerates, kept although their format is ignored: the
# raw US series, the simulator's parameter files, and the parameter design the
# 15 GB dataset was simulated from.
!dataset/us_real.csv
!model/dsk_sfc/**/*.json
!out/dataset/abm_system_design.csv
